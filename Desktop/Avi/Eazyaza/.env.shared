# 🚀 EazyAza Platform - Shared Development Environment
# Copy this file to each project directory as .env and update values as needed

# ===============================
# 📊 DATABASE CONFIGURATION
# ===============================
DATABASE_URL=postgres://postgres@localhost/medusa-eazyaza-platform
POSTGRES_DB=medusa-eazyaza-platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===============================
# 🔐 SECURITY SECRETS
# ===============================
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ===============================
# 🌐 REDIS CONFIGURATION
# ===============================
REDIS_URL=redis://localhost:6379

# ===============================
# 🔗 CORS CONFIGURATION
# ===============================
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com

# ===============================
# 🎯 MEDUSA CONFIGURATION
# ===============================
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=eazyaza-platform-storefront
MEDUSA_BACKEND_URL=http://localhost:9000

# ===============================
# 🏪 MULTI-TENANCY CONFIGURATION
# ===============================
ROOT_DOMAIN=localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us

# ===============================
# 🔑 PUBLISHABLE KEYS
# ===============================
# Get this from Medusa Admin -> Settings -> API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_99e6c52a6683669a77dfd772e0a7e0e1710f79d574bd9c181a9b9eb8af19d544

# ===============================
# 🚀 DEVELOPMENT SERVERS
# ===============================
# Medusa Backend: http://localhost:9000
# Medusa Admin: http://localhost:9000/app
# Next.js Storefront: http://localhost:8000
# Demo Tenant URLs:
# - http://acme-store.localhost:8000
# - http://fashion-hub.localhost:8000
# - http://naija-market.localhost:8000
# - http://tech-world.localhost:8000

# ===============================
# ☁️ PRODUCTION OVERRIDES
# ===============================
# Uncomment and update for production deployment
# DATABASE_URL=postgresql://username:password@host:port/database
# REDIS_URL=redis://username:password@host:port
# ROOT_DOMAIN=yourdomain.com
# MEDUSA_BACKEND_URL=https://api.yourdomain.com
# JWT_SECRET=your-super-secure-jwt-secret
# COOKIE_SECRET=your-super-secure-cookie-secret

# ===============================
# 📦 AWS DEPLOYMENT KEYS
# ===============================
# For AWS deployment (keep these secret!)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-s3-bucket-name